{
  "name": "opencode-arise-v2",
  "version": "0.2.0",
  "description": "ARISE shadow orchestration for OpenCode v2 with live-catalog model routing",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-arise-v2": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "opencode.example.jsonc",
    "index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24",
    "zod": "4.1.8",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GilbertKrantz/opencode-arise.git"
  },
  "homepage": "https://github.com/GilbertKrantz/opencode-arise/tree/opencode-v2"
}
